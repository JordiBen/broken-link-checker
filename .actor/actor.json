{
  "actorSpecification": 1,
  "name": "broken-link-checker",
  "title": "Broken Link Checker & SEO Crawler: 404s, Images, Redirects",
  "description": "Crawl a website and find every broken link (404s), dead external link, missing image, script or stylesheet, with the pages they appear on and the anchor text. Respects robots.txt. Priced per page crawled, not per link: $2 per 1,000 pages.",
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "../Dockerfile",
  "readme": "../README.md",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Broken & blocked links",
          "transformation": {
            "fields": [
              "verdict",
              "status",
              "url",
              "resourceType",
              "internal",
              "foundOn",
              "anchorTexts",
              "error",
              "site"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "verdict": {
                "label": "Verdict"
              },
              "status": {
                "label": "HTTP",
                "format": "number"
              },
              "url": {
                "label": "Link",
                "format": "link"
              },
              "resourceType": {
                "label": "Type"
              },
              "internal": {
                "label": "Internal",
                "format": "boolean"
              },
              "foundOn": {
                "label": "Found on",
                "format": "array"
              },
              "anchorTexts": {
                "label": "Anchor text",
                "format": "array"
              },
              "error": {
                "label": "Error"
              },
              "site": {
                "label": "Site",
                "format": "link"
              }
            }
          }
        }
      }
    }
  }
}
